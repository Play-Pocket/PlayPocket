{
  "name": "PlayPocket",
  "version": "1.5.3",
  "description": "Offline playlist player (PlayPocket)",
  "main": "main.js",
  "author": "Takkunlego0916",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify-release.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.github.takkunlego0916.playpocket",
    "productName": "PlayPocket",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/discord-rpc/**/*",
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "npmRebuild": false,
    "files": [
      "app/**/*",
      "main/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "README.md",
      "LICENSE",
      "!node_modules/register-scheme/**/*"
    ],
    "win": {
      "target": "zip",
      "icon": "assets/icon.ico",
      "artifactName": "${productName}.${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icons/appIcon.icns",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "discord-rpc": "^4.0.1",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
