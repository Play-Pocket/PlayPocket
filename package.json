{
  "name": "PlayPocket",
  "version": "1.4.0",
  "description": "Offline playlist player (PlayPocket)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "dist": "electron-builder --publish never"
  },
  "author": "Takkunlego0916",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.takkunlego0916.playpocket",
    "productName": "PlayPocket",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/discord-rpc/**/*"
    ],
    "files": [
      "app/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "app/icons/appIcon.ico"
    },
    "mac": {
      "icon": "app/icons/appIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "app/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Takkunlego0916",
        "repo": "PlayPocket"
      }
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
